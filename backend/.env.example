# =============================================================
# SRCW Assistant - Environment Configuration
# Sri Ramakrishna College of Arts & Science for Women, Coimbatore
# =============================================================

# LLM Provider switch: gemini | ollama | openrouter
LLM_PROVIDER=gemini

# --- Gemini API (Recommended: fast, generous free tier) ---
# Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Ollama (Local, offline, free). Run: ollama pull llama3.2 ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- OpenRouter (Switchable models, free options available) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- RAG & Retrieval Tuning Knobs ---
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
# Cosine similarity cutoff (0.0 to 1.0). Hits below this trigger fallback contact message
SCORE_THRESHOLD=0.45

# --- Local Embedding Model ---
# Multilingual embedding model support for English, Tamil & Tanglish
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- API Security & Rate Limiting ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://srcw.ac.in
RATE_LIMIT=20/minute
